# ============================================================
# GW Digital Company — Variáveis de ambiente (MÓDULO 15)
# Copie para .env.local (desenvolvimento) ou .env (produção):
#   cp .env.example .env.local
# ============================================================

# ── Site (público) ──────────────────────────────────────────
# URL pública do site (usada em metadados SEO e OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Aplicação ───────────────────────────────────────────────
# Porta do servidor Next.js
PORT=3000
# Nome do host (usar 0.0.0.0 em containers)
HOSTNAME=0.0.0.0

# ── Banco de dados (Módulo 12 — futuras APIs) ───────────────
DATABASE_URL=postgresql://gwdc:gwdc_secret@localhost:5432/gwdc
MONGODB_URL=mongodb://localhost:27017/gwdc
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
ELASTICSEARCH_URL=http://localhost:9200

# ── Autenticação (produção — trocar para OIDC real) ─────────
# GWDC usa sessão simulada nos MVPs; em produção:
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=substitua-por-um-segredo-aleatorio-64-caracteres
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── IA (Módulo 13 — provedores externos, opcional) ──────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Observabilidade (Módulo 12) ─────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Docker Compose ──────────────────────────────────────────
POSTGRES_USER=gwdc
POSTGRES_PASSWORD=gwdc_secret
POSTGRES_DB=gwdc
GRAFANA_PASSWORD=admin

# ⚠️ NUNCA commitar valores reais. Gere segredos com:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
